# ============================================================
# Restaurantes (Punto C) — variables de producción.
#
# `node prod.js` crea este archivo a partir de .env.example y sincroniza
# HOST_*, CORS_ORIGIN y PUBLIC_HTTP_PORT desde prod.config.json. También
# genera POSTGRES_PASSWORD si está vacío. NO se versiona.
# ============================================================

# ── Dominios (los sirve el Caddy interno por Host) ──────────
HOST_APP=restaurant.jcti.xyz
HOST_RESERVAS=reservas.jcti.xyz
HOST_COCINA=cocina.jcti.xyz
HOST_ADMIN=admin.jcti.xyz
HOST_MESERO=mesero.jcti.xyz

# ── Puerto del host (SOLO diagnóstico, en loopback) ─────────
# El edge compartido habla con restaurants_app:8080 por la red shared_edge.
PUBLIC_HTTP_PORT=127.0.0.1:30390

# ── Base de datos (red interna, sin puertos publicados) ─────
POSTGRES_USER=restaurants
POSTGRES_DB=restaurants
# Generada por prod.js si queda vacía. Usa solo [a-f0-9] para no romper la URL.
POSTGRES_PASSWORD=

# ── Backend ─────────────────────────────────────────────────
# Lista separada por comas. prod.js la sincroniza desde prod.config.json.
CORS_ORIGIN=
# 1 = aplica migraciones y seed idempotentes al arrancar.
RUN_DB_MIGRATIONS=1
TZ=America/Bogota
