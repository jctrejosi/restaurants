{
  "name": "restaurants-backend",
  "version": "0.1.0",
  "description": "API del software de restaurantes: reservas, pedidos, meseros, KDS y administración",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "dotenvx run -f .env.development.local -- nest start --watch --preserveWatchOutput",
    "start": "dotenvx run -f .env.development.local -- nest start",
    "start:debug": "dotenvx run -f .env.development.local -- nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "node scripts/check-db.js",
    "db:seed": "ts-node scripts/seed.ts",
    "db:test": "ts-node scripts/test-db.ts",
    "db:bench": "ts-node scripts/bench-db.ts"
  },
  "dependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/websockets": "^11.1.28",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "8.20.0",
    "@types/uuid": "11.0.0",
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.10.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "resend": "^6.18.1",
    "rxjs": "7.8.2",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "5.0.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "uuid": "14.0.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.11.1",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "6.0.0",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.5",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      ".+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
